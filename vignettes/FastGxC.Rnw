\author{Charlie Wang \And Lena Krockenberger \And Brunilda Balliu \And Anthony Zhao}
\Plainauthor{Charlie Wang, Lena Krockenberger, Brunilda Balliu, Anthony Zhao}

\title{FastGxC: An R Package for Fast and Powerful Context-Specific eQTL 
Mapping in Bulk and Single-Cell Data}
\Plaintitle{FastGxC: An R Package for Fast and Powerful Context-Specific 
eQTL Mapping in Bulk and Single-Cell Data}
\Shorttitle{FastGxC: Context-Specific eQTL Mapping in R}

\Abstract{
  Mapping expression quantitative trait loci (eQTLs) is essential for understanding how genetic variation influences gene regulation across different contexts (i.e., cell types, tissues, and cellular states) and for linking disease-associated variants to their regulatory targets. There are many existing eQTL mapping approaches, but they face a fundamental tradeoff: linear mixed model (LMM) methods are statistically rigorous but computationally prohibitive at the transcriptome scale, while context-by-context mapping is fast but systematically underpowered and produces miscalibrated results. We present \pkg{FastGxC}, an \proglang{R} package that implements a fast, statistically principled framework for context-specific eQTL mapping in bulk and single-cell RNA-seq data. \pkg{FastGxC} decomposes gene expression into a context-shared component and context-specific components, then estimates genetic effects on each component independently using ultra-fast linear regression. This reparameterization is statistically equivalent to a powerful LMM with a genotype by context interaction while reducing runtime from years to minutes. The package provides an end-to-end workflow including data simulation, expression decomposition, eQTL mapping via \pkg{MatrixEQTL} \citep{Shabalin:2012} or \pkg{tensorqtl} 
\citep{TaylorWeiner:2019}, and hierarchical FDR control across genes, SNPs, 
and contexts via \pkg{TreeQTL} \citep{Peterson:2016} or \pkg{TreeBH} 
\citep{Bogomolov:2020}. All analyses in this paper can be reproduced using the scripts provided in the package's GitHub Wiki.
}

\Keywords{eQTL mapping, context-specific, gene expression, \proglang{R}}
\Plainkeywords{eQTL mapping, context-specific, pseudo-bulk, gene expression, R}

